<?xml version="1.0" encoding="utf-8"?>
<!--
  LPROTECT property sheet (Visual Studio / MSBuild, x64).

  Cách dùng: mở View -> Property Manager, chuột phải project (từng cấu hình
  Debug|x64 và Release|x64 hoặc "All Configurations") -> Add Existing Property
  Sheet... -> chọn file này. Thế là xong: include path, thư viện, define
  LP_BUILD_SEED và chuẩn C++17 được thiết lập tự động.

  LƯU Ý:
   * SDK này có lib cho CẢ Win32 (x86) LẪN x64. Property sheet tự chọn theo
     Platform đang build ($(Platform) = "Win32" hoặc "x64").
   * lprotect.lib được build với LP_BUILD_SEED=0xA5C3F17B. Property sheet đặt
     ĐÚNG giá trị đó cho code app -> không bao giờ lệch. Muốn đổi seed phải build
     lại lib TỪ SOURCE (SDK dựng sẵn không đổi seed được).
   * Runtime library mặc định: Release = /MD, Debug = /MDd. Project app phải
     dùng cùng (đây là mặc định của VS nên thường không cần sửa).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <LProtectRoot>$(MSBuildThisFileDirectory)</LProtectRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(LProtectRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>LP_BUILD_SEED=0xA5C3F17B;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(LProtectRoot)lib\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- libcurl.lib (static, schannel) + deps he thong cho transport IPv4. Cung thu muc lib\$(Platform)\$(Configuration) voi lprotect.lib (Debug = libcurl-d da copy thanh libcurl.lib). -->
      <AdditionalDependencies>lprotect.lib;libcurl.lib;winhttp.lib;bcrypt.lib;iphlpapi.lib;advapi32.lib;ws2_32.lib;crypt32.lib;secur32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
